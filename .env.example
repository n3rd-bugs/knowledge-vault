# Knowledge Vault runtime config (PLAN.md §3). Copy to .env and fill secrets.
# NOTE: comments always on their own line — python-dotenv treats an inline
# comment after an empty value as the value, and systemd EnvironmentFile
# never strips inline comments at all.

# No password inside the URL: kbcore.config injects KB_DB_PASSWORD (URL-quoted)
# at runtime. Keeping it out dodges dotenv/compose ${...} interpolation entirely.
KB_DB_URL=postgresql://kb@127.0.0.1:5433/kb
KB_DB_PASSWORD=change-me

# Bearer token for MCP (openssl rand -hex 32)
KB_TOKEN=change-me-long-random

# Bind address: loopback or the Tailscale IP — never 0.0.0.0 (SEC-1)
KB_BIND=127.0.0.1
KB_PORT=8321

OLLAMA_URL=http://127.0.0.1:11434
KB_EMBED_MODEL=bge-m3
KB_EMBED_DIM=1024
# auto|cpu escape hatch (OPS-1)
KB_EMBED_DEVICE=auto
KB_EXTRACT_MODEL=qwen2.5:14b-instruct-q4_K_M

KB_INBOX=~/kb/inbox
KB_RAW=~/kb/raw
KB_BACKUPS=~/kb/backups

# Colon-separated repo paths for the docs scanner, e.g. ~/work/motor-ctl:~/work/docx-tools
KB_GIT_REPOS=

KB_ARCHIVE_AFTER_DAYS=180
KB_DUP_THRESHOLD=0.97
