# kb-consolidate.timer — fire the nightly consolidation at 01:00 (PLAN.md §9)
[Unit]
Description=Nightly Knowledge Vault consolidation at 01:00

[Timer]
# 01:00 (owner decision 2026-08-01, was 03:30): the drain stops starting new
# work at the NOON deadline, so every hour earlier is an hour more of window —
# 11h instead of 8.5h. At 150W with cohort 30 that margin is what clears a
# backlog night (recovery/backfill) instead of deferring half of it.
OnCalendar=*-*-* 01:00
Persistent=true
Unit=kb-consolidate.service

[Install]
WantedBy=timers.target
