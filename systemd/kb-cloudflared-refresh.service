# kb-cloudflared-refresh — monthly re-pull of the public edge container
# The sole public 443 ingress runs cloudflare/cloudflared:latest (compose sets
# --no-autoupdate + restart:unless-stopped), so the binary only updates when
# someone pulls — which otherwise never happens. This re-pulls the newest image
# and recreates the container so cloudflared security fixes land (PLAN.md §9, OPS).
# Install: bash scripts/install_systemd.sh (the .timer is installed but NOT enabled;
# enable manually with: systemctl --user enable --now kb-cloudflared-refresh.timer)
#
# KILL SWITCH: `docker compose stop kb-cloudflared` removes all public exposure.
# The timer's Persistent=true catches up a run missed while the machine was off at
# the NEXT boot/login — but the ExecCondition below means that catch-up only fires
# when the edge is CURRENTLY RUNNING, so a deliberately-stopped tunnel is NEVER
# silently revived (the monthly refresh must not reverse the kill switch).
#
# network-online.target is INTENTIONALLY NOT used: in a systemd --user manager it
# has no wait-online provider and cannot order against docker.service, so it is a
# no-op. Real readiness is gated by the ExecStartPre retry loop instead.
[Unit]
Description=Knowledge Vault monthly cloudflared edge refresh (re-pull + recreate)
# This unit had never once done its job (see COMPOSE_PROJECT_NAME below) and
# nothing said so. A monthly security refresh that fails silently is worse than
# no refresh: it is a security refresh you believe you have.
OnFailure=kb-notify-fail@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/kb/repo
EnvironmentFile=%h/kb/repo/.env
# WHY THIS LINE EXISTS: with `-f %h/kb/repo/docker-compose.yml`, compose derives
# the project name from that path's directory — and %h/kb/repo is a SYMLINK, so
# the project came out as "repo" while the running stack is "data-server". Every
# invocation therefore addressed an empty project: `pull` fetched nothing useful
# and `up -d` would have created a SECOND, parallel edge container rather than
# refreshing the live one. The unit has never worked since it was written.
# Pinning the name (equivalent to `-p data-server`) makes it address the real
# stack. Compose's own default for the running stack is the directory basename
# of the repo checkout, /home/usama/data-server → data-server.
Environment=COMPOSE_PROJECT_NAME=data-server
# Respect the kill switch: skip (do not fail) unless kb-cloudflared is RUNNING.
# `docker inspect` prints "true"/"false" and exits 0 for any existing container, so
# gate on the STRING — a stopped or absent edge yields non-"true" and the unit is
# skipped, never restarted (an ExecCondition non-zero is a clean skip, not a fail).
ExecCondition=/bin/sh -c '[ "$(docker inspect -f {{.State.Running}} kb-cloudflared 2>/dev/null)" = "true" ]'
# User-scope has no network-online.target: wait for the docker daemon to be ready
# (a boot-time Persistent catch-up can fire before it is), retrying instead of
# failing the whole month on a cold start (review finding).
ExecStartPre=/bin/sh -c 'for i in 1 2 3 4 5 6; do docker info >/dev/null 2>&1 && exit 0; sleep 10; done; exit 1'
ExecStart=docker compose -f %h/kb/repo/docker-compose.yml pull kb-cloudflared
# --no-deps: refresh ONLY the edge, never (re)start its depends_on chain
# (kb-mcp-public → kb-mcp), so the refresh cannot bring public exposure back up
# beyond the single already-running edge container (review finding).
ExecStart=docker compose -f %h/kb/repo/docker-compose.yml up -d --no-deps kb-cloudflared
# A transient pull failure retries a few times this boot rather than skipping a
# whole month (permitted for Type=oneshot on current systemd).
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true

[Install]
WantedBy=default.target
