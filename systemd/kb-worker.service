# kb-worker — Knowledge Vault collector agent (inbox watcher + repo docs scan, PLAN.md §7/§9)
# Install: bash scripts/install_systemd.sh   (systemd user unit)
[Unit]
Description=Knowledge Vault collector (inbox watcher + daily repo docs scan)
After=network.target
# Stop retrying after 5 failed starts in 60s instead of crash-looping forever
# (RestartSec=3 outpaces the user manager's default 5-in-10s window).
StartLimitIntervalSec=60
StartLimitBurst=5
# Fires when the restart budget is exhausted: a dead collector means the inbox
# silently stops being ingested, which looks like "nothing happened lately".
OnFailure=kb-notify-fail@%n.service

[Service]
Type=simple
WorkingDirectory=%h/kb/repo
EnvironmentFile=%h/kb/repo/.env
ExecStart=%h/kb/repo/.venv/bin/python -m kbworker.watcher
Restart=on-failure
RestartSec=3
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=default.target
