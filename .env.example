# Knowledge Vault runtime config (PLAN.md §3). Copy to .env and fill secrets.
# NOTE: comments always on their own line — python-dotenv treats an inline
# comment after an empty value as the value, and systemd EnvironmentFile
# never strips inline comments at all.

# No password inside the URL: kbcore.config injects KB_DB_PASSWORD (URL-quoted)
# at runtime. Keeping it out dodges dotenv/compose ${...} interpolation entirely.
KB_DB_URL=postgresql://kb@127.0.0.1:5433/kb
KB_DB_PASSWORD=change-me

# Bearer token for MCP (openssl rand -hex 32)
KB_TOKEN=change-me-long-random

# Bind address: loopback or the Tailscale IP — never 0.0.0.0 (SEC-1)
KB_BIND=127.0.0.1
KB_PORT=8321
# Phase 6 public services (REST facade + read-only web UI)
KB_REST_PORT=8322
KB_WEB_PORT=8323
# Allow 0.0.0.0 binds — ONLY inside a container fronted by a TLS proxy/tunnel
# (this deployment: the Cloudflare Tunnel edge on 443). Host-public binds still refused.
KB_ALLOW_ANY_BIND=false
# Public/cloud instance: reads see only projects flagged public, writes to
# non-public projects are rejected. Local/full instances leave this false.
KB_PUBLIC_ONLY=false

# --- OAuth + public surfaces (claude.ai connector, web UI sign-in) ------------
# Enable Google OAuth on the public MCP (claude.ai web/mobile). When true the
# public instance accepts BOTH OAuth and the static bearer. Local instances: false.
KB_OAUTH_ENABLED=false
# Public base URL for OAuth metadata + the /auth/callback redirect. REQUIRED when
# KB_OAUTH_ENABLED=true (no default — the server refuses to start without it).
# Left COMMENTED so an unedited `cp .env.example .env` stays empty and the loud
# startup guards actually fire (an active example.com value would satisfy them).
# KB_PUBLIC_URL=https://kb.your-host.example
# Public REST base (e.g. https://api.<host>), used by kb_setup to pre-fill remote
# session-hook configs. Empty -> kb_setup emits a generic placeholder.
# KB_PUBLIC_REST_URL=https://api.your-host.example
# Public base URL of the read-only web UI. REQUIRED when Google sign-in is
# configured (GOOGLE_CLIENT_ID set); also pins the REST CORS origin.
# KB_WEB_PUBLIC_URL=https://web.your-host.example
# Comma-separated allowlist of emails permitted to sign in to the web UI via Google.
KB_WEB_ALLOWED_EMAILS=
# Lifetime (seconds) of the FastMCP-issued OAuth access token (decoupled from
# Google's ~1h upstream expiry so a client hiccup isn't an hourly logout).
KB_OAUTH_TOKEN_TTL=86400
# Google OAuth app credentials (claude.ai connector + web UI sign-in). Secrets — keep in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OLLAMA_URL=http://127.0.0.1:11434
KB_EMBED_MODEL=bge-m3
KB_EMBED_DIM=1024
# auto|cpu escape hatch (OPS-1)
KB_EMBED_DEVICE=auto
KB_EXTRACT_MODEL=qwen3:14b
# Deep search (explicit, user-invoked, local Ollama). Empty -> reuse the extractor.
KB_DEEP_MODEL=
# Max items whose full bodies deep-search reads before synthesizing.
KB_DEEP_MAX_ITEMS=16

KB_INBOX=~/kb/inbox
KB_RAW=~/kb/raw
KB_BACKUPS=~/kb/backups

# Colon-separated repo paths for the docs scanner, e.g. ~/work/motor-ctl:~/work/docx-tools
KB_GIT_REPOS=

KB_ARCHIVE_AFTER_DAYS=180
KB_DUP_THRESHOLD=0.97

# WP2 graph expansion: default n-hop relation-neighbor pull-in in search (0=off,
# capped at 3). The ONLY way to enable expansion for CLI `kb search`; MCP/REST
# callers can override per call with expand=true/false.
KB_GRAPH_EXPAND_HOPS=0

# Auto-resolution kill switches (owner decision, 2026-07). Both true = automation
# active; set false to revert to propose-only (everything waits for a human).
# Doc-refresh: a re-ingested newer revision of the SAME source doc supersedes the stale one.
KB_AUTO_SUPERSEDE_DOC_REFRESH=true
# Evidence: a lopsided-evidence contradiction auto-resolves after a 2-night stable margin.
KB_AUTO_RESOLVE_EVIDENCE=true
# Search-quality regression sentinel: nightly consolidation replays the golden
# retrieval eval and flags hit@5/MRR drops. Set false to skip the eval (kill switch).
KB_EVAL_IN_CONSOLIDATION=true
# Anchored absolute floor for the sentinel: flag whenever hit@5 / MRR fall below
# these regardless of trend (catches gradual sub-epsilon drift; anchors auto-resolve).
KB_EVAL_MIN_HIT5=0.75
KB_EVAL_MIN_MRR=0.5

# Extractor residency: -1 keeps the 14B loaded (fast runs, ~10GB VRAM); 0 unloads per call
KB_LLM_KEEP_ALIVE=-1
